    {"id":"BR-SEG100-APPV-REQUEST-TABLES","title":"Moneris request tables shall use the source-defined table IDs, fixed lengths, and Moneris terminal/merchant/context values.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix V","segment":"135","rule":"moneris-request-table-layout"},"status":"REVIEW_REQUIRED"},
    {"id":"BR-SEG100-APPV-COMPLETION","title":"Moneris completion data shall carry the authorization amount and sequence linkage required by the source tables.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix V","segment":"135","rule":"moneris-completion-linkage"},"status":"REVIEW_REQUIRED"},
    {"id":"BR-SEG100-APPV-SECURITY","title":"Moneris request/response data shall validate MAC, encryption-key indicators, and terminal capability fields according to the Moneris contract.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix V","segment":"135,136","rule":"moneris-security-data"},"status":"REVIEW_REQUIRED"}
