  "businessRequirements": [
    {
      "id": "BR-SEG100-BASE-001",
      "title": "A standard non-EMV request may contain Segment 100 only when no additional data is required.",
      "sourceAnchors": [
        {"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"100","rule":"segment-100-required-once"}
      ]
    },
    {
      "id": "BR-SEG100-EMV-001",
      "title": "An EMV purchase must include Segment 130 with Segment 100.",
      "sourceAnchors": [
        {"specification":"ATL105","version":"2026-3","section":"11.8.1","segment":"130","rule":"section-3-required-for-emv"}
      ]
    },
    {
      "id": "BR-SEG100-FLEET-001",
      "title": "A fleet transaction requiring fleet data must include Segment 101 with Segment 100.",
      "sourceAnchors": [
        {"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"101","rule":"fleet-data-required"}
      ]
    },
    {
      "id": "BR-SEG100-FUEL-001",
      "title": "A fuel transaction requiring product data must include Segment 102 with Segment 100.",
      "sourceAnchors": [
        {"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"102","rule":"product-or-fuel-data-required"}
      ]
    },
    {
      "id": "BR-SEG100-MULTI-001",
      "title": "A transaction with multiple applicable data categories must include Segment 100 and every required companion segment.",
      "sourceAnchors": [
        {"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"101,102","rule":"multiple-section-3-segments-required"}
      ]
    },
    {
      "id": "BR-SEG100-REVIEW-001",
      "title": "An unknown segment combination must be held for review rather than silently accepted or rejected.",
      "sourceAnchors": [
        {"specification":"ATL105","version":"2026-3","section":"12","segment":"UNKNOWN","rule":"unknown-combination-requires-review"}
      ]
    }
  ],
