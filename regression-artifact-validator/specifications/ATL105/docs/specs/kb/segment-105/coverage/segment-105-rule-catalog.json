    {"ruleId":"SEG105-R-013","title":"Sequence Number is required","class":"field","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"12.6","segment":"105","element":"86","rule":"sequence-number"}},
    {"ruleId":"SEG105-R-014","title":"Currency Code is optional when allowed by the message context","class":"conditional","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"12.6","segment":"105","element":"20","rule":"currency-code"}},
    {"ruleId":"SEG105-R-015","title":"Grand Total, Card Label, Card Type Total Count, and Card Type Total Amount are required","class":"structure","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"12.6","segment":"105","rule":"totals-aggregate-fields"}},
    {"ruleId":"SEG105-R-016","title":"Request and response correlation follows approved totals lifecycle policy","class":"lifecycle","severity":"review","status":"REVIEW_REQUIRED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"12.6","segment":"105","element":"86","rule":"request-response-correlation"}},
    {"ruleId":"SEG105-R-017","title":"Segment 119 use requires an approved proprietary-load selection rule","class":"compatibility","severity":"review","status":"REVIEW_REQUIRED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"12.6","segment":"119","rule":"totals-load-alternative"}},
    {"ruleId":"SEG105-R-018","title":"A Totals Request contains Data Sections 1 and 3 only; it has no Data Section 2 and no Segment 100","class":"structure","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"11.4.1.1","segment":"105","rule":"sections-1-and-3-no-section-2"}},
    {"ruleId":"SEG105-R-019","title":"In a Totals Request, Segment 105 is the only data segment and occupies Data Section 3 Field No. 3","class":"structure","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"11.4.1.1,12.6","segment":"105","rule":"sole-segment-field-3"}},
    {"ruleId":"SEG105-R-020","title":"In a Totals Request, Element 63 (Number of Segments) is 01","class":"structure","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"11.4.1.1,13","segment":"105","element":"63","rule":"totals-request-segment-count"},"note":"Section 11.4.1.1 gives the fixed value 01. Chapter 13 allows up to two digits, so the validator accepts 1 or 01, as for every other message."},
    {"ruleId":"SEG105-R-021","title":"Segment 105 maximum length is 409 characters","class":"serialization","severity":"error","status":"CONFIRMED","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"11.4.1.1,12.6","segment":"105","element":"84","rule":"max-length-409"}},
    {"ruleId":"SEG105-R-022","title":"Segment 105 is present in every Totals Request","class":"structure","severity":"error","status":"PROVISIONAL","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"11.4.1.1","segment":"105","rule":"segment-105-presence"},"note":"The Section 11.4.1.1 table marks Segment 105 Conditional ('Sent only on transactions requiring totals data'), but Element 63 is fixed at 01 and the message has no other segment. Enforced as required until the SME answers SEG105-SME-010."}
