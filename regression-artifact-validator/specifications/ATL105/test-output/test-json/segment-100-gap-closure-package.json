  "businessRequirements": [
    {"id":"BR-SEG100-GAP-INFO-BYTE","title":"Segment 100 Information Byte shall use the source-defined single-message, multimessage, or download value.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"44","rule":"information-byte"}]},
    {"id":"BR-SEG100-GAP-ACCOUNT","title":"Segment 100 shall contain the account number or identification value required by the transaction context.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"2","rule":"account-number"}]},
    {"id":"BR-SEG100-GAP-DISCRETIONARY","title":"Card Discretionary Block Data shall be validated to its source-defined conditional length and usage.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"12","rule":"card-discretionary-block-data"}]},
    {"id":"BR-SEG100-GAP-PIN","title":"Encrypted PIN Block Data shall use the source-defined DUKPT KSN and PIN-block representation when PIN processing applies.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"33","rule":"encrypted-pin-block-data"}]},
    {"id":"BR-SEG100-GAP-PUMP","title":"Pump/Lane Number shall be present and correctly formatted when the transaction is a fuel or lane-specific flow.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"79","rule":"pump-lane-number"}]},
    {"id":"BR-SEG100-GAP-FUEL-AMOUNT","title":"Fuel Purchase Amount shall represent the net fuel amount when fuel purchase data applies.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"41","rule":"fuel-purchase-amount"}]},
    {"id":"BR-SEG100-GAP-NONFUEL-AMOUNT","title":"Nonfuel Amount shall represent the net nonfuel, noncash, and nontax amount when applicable.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"58","rule":"nonfuel-amount"}]},
    {"id":"BR-SEG100-GAP-TAX-AMOUNT","title":"Tax Amount shall represent the total tax amount when tax data applies.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"99","rule":"tax-amount"}]},
    {"id":"BR-SEG100-GAP-CASH-AMOUNT","title":"Cash Amount shall represent the total cash amount when cash data applies.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"17","rule":"cash-amount"}]},
    {"id":"BR-SEG100-GAP-APPROVAL","title":"Approval Number shall be validated when the transaction flow requires an approval reference.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"5","rule":"approval-number"}]},
    {"id":"BR-SEG100-GAP-LOCAL-DATETIME","title":"Local Date and Local Time shall use the source-defined ten-character representation when required by the flow.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"12.1","segment":"100","element":"49","rule":"local-date-time"}]},
    {"id":"BR-SEG100-GAP-EBT","title":"An EBT flow requiring EBT data shall include Segment 103 in addition to Segment 100.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"103","rule":"ebt-data-required"}]},
    {"id":"BR-SEG100-GAP-PURCHASE-CARD","title":"A purchase-card flow requiring purchase-card data shall include Segment 104 in addition to Segment 100.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"104","rule":"purchase-card-data-required"}]},
    {"id":"BR-SEG100-GAP-VARIABLE-INFO","title":"A flow requiring variable information shall include Segment 111 in addition to Segment 100.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"111","rule":"variable-information-required"}]},
    {"id":"BR-SEG100-GAP-NFC","title":"An NFC tokenized flow shall include Segment 123 in addition to Segment 100.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"123","rule":"nfc-tokenization-required"}]},
    {"id":"BR-SEG100-GAP-MONERIS","title":"A Moneris authorizer flow shall include Segment 135 in addition to Segment 100.","sourceAnchors":[{"specification":"ATL105","version":"2026-3","section":"11.1.1","segment":"135","rule":"moneris-authorizer-required"}]}
