{
  "appendix": "O",
  "title": "Payment Token Terminologies",
  "specification": "ATL105",
  "specificationVersion": "2026-3",
  "applicability": "Applies conditionally to Segment 100 tokenized transactions and related security/entry-mode context.",
  "source": "docs/specs/extracted_text.txt Appendix O-1",
  "businessRequirements": [
    {"id":"BR-SEG100-APPO-TOKEN-ACCOUNT","title":"A payment token used as Segment 100 Account Number shall be a valid 13-19 digit token value subject to account validation and designated token BIN rules.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"100","element":"2","rule":"payment-token-account-number"},"status":"COVERED"},
    {"id":"BR-SEG100-APPO-TOKEN-EXPIRATION","title":"Payment Token Expiration Date shall be populated in the PAN Expiration Date field when token processing requires it.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"100","element":"12","rule":"payment-token-expiration-date"},"status":"COVERED"},
    {"id":"BR-SEG100-APPO-CRYPTOGRAM","title":"In-App token cryptogram data shall use the source-defined 28-byte or 56-byte base64 representation and token-data-block interpretation.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"100","element":"33","rule":"payment-token-cryptogram"},"status":"COVERED"},
    {"id":"BR-SEG100-APPO-CRYPTOGRAM-BLOCK-SPLIT","title":"56 bytes of cryptogram data shall be interpreted as Token Data Block A followed by Token Data Block B; 28 bytes of cryptogram data shall be interpreted as Token Data Block A only.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"100","element":"33","rule":"payment-token-cryptogram-block-split"},"status":"COVERED"},
    {"id":"BR-SEG100-APPO-TOKEN-NOT-PAN","title":"A payment token value must not be the same value as the cardholder's actual PAN.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"100","element":"2","rule":"payment-token-not-pan"},"status":"COVERED"},
    {"id":"BR-SEG100-APPO-TOKEN-LUHN","title":"A payment token shall pass basic account-number validation rules, including the LUHN check, and shall fall within a BIN range designated and flagged as a token BIN range.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"100","element":"2","rule":"payment-token-luhn-bin-validation"},"status":"COVERED"},
    {"id":"BR-SEG100-APPO-ENTRY-MODE","title":"Tokenized Segment 100 transactions shall use a POS Entry Mode that identifies the token presentment mode.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix O","segment":"111","element":"113","rule":"payment-token-entry-mode"},"status":"COVERED"}
  ],
  "testScenarios": [
    {"id":"TS-SEG100-APPO-TOKEN-ACCOUNT","covers":["BR-SEG100-APPO-TOKEN-ACCOUNT","BR-SEG100-APPO-TOKEN-NOT-PAN","BR-SEG100-APPO-TOKEN-LUHN"],"status":"COVERED"},
    {"id":"TS-SEG100-APPO-TOKEN-CONTEXT","covers":["BR-SEG100-APPO-TOKEN-EXPIRATION","BR-SEG100-APPO-CRYPTOGRAM","BR-SEG100-APPO-CRYPTOGRAM-BLOCK-SPLIT","BR-SEG100-APPO-ENTRY-MODE"],"status":"COVERED"}
  ],
  "testCases": [
    {"id":"TC-SEG100-APPO-TOKEN-ACCOUNT","scenarioId":"TS-SEG100-APPO-TOKEN-ACCOUNT","positive":"Valid tokenized account representation that is not the actual PAN and passes LUHN","negative":["PAN/token collision","invalid token length","LUHN check fails"],"status":"COVERED"},
    {"id":"TC-SEG100-APPO-TOKEN-CONTEXT","scenarioId":"TS-SEG100-APPO-TOKEN-CONTEXT","positive":"Token expiration, cryptogram block split, and entry mode agree with token context","negative":["wrong cryptogram size","invalid token expiration month","unrecognized POS Entry Mode code"],"status":"COVERED"}
  ],
