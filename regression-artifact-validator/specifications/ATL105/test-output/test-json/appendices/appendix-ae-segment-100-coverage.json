    {"id":"BR-SEG100-APPAE-FINAL-AMOUNT","title":"Completion amount equals evidenced final amount.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix AE-1","rule":"incremental-completion-final-amount"},"status":"PARTIALLY_COVERED"},
    {"id":"BR-SEG100-APPAE-EXPIRATION-WINDOW","title":"14 days for cruise/lodging/vehicle rental or seven for other rentals, measured from initial not last incremental.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix AE-1","rule":"estimated-authorization-expiration-window"},"status":"PARTIALLY_COVERED"},
    {"id":"BR-SEG100-APPAE-LONG-STAY-RESTART","title":"For longer stays/rentals, complete first then initiate second on/before relevant day 14/7.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix AE-1","rule":"estimated-long-stay-restart"},"status":"PARTIALLY_COVERED"},
