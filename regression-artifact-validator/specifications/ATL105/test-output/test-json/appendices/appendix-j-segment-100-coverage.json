  "businessRequirements": [
    {"id":"BR-SEG100-APPJ-COMPOSITION","title":"POS Entry Mode Element 113 shall contain a valid two-digit PAN Entry Mode followed by a valid one-digit Terminal Capability Mode.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix J","segment":"111","element":"113","rule":"pos-entry-mode-composition"},"status":"PARTIALLY_COVERED"},
    {"id":"BR-SEG100-APPJ-PAN-MODES","title":"PAN Entry Mode shall use a source-defined value consistent with the card-entry method and transaction context.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix J","segment":"111","element":"113","rule":"pan-entry-mode"},"status":"PARTIALLY_COVERED"},
    {"id":"BR-SEG100-APPJ-TERMINAL-CAPABILITY","title":"Terminal Capability Mode shall reflect the POS PIN, EMV, contactless, or mPOS capability hierarchy.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix J","segment":"111","element":"113","rule":"terminal-capability-mode"},"status":"PARTIALLY_COVERED"},
    {"id":"BR-SEG100-APPJ-LIFECYCLE-PERSISTENCE","title":"POS Entry Mode shall persist across lifecycle transactions except for source-defined exceptions, including PAN mode 90 referenced by a completion or void using mode 02.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix J","segment":"111","element":"113","rule":"entry-mode-lifecycle-persistence"},"status":"REVIEW_REQUIRED"},
    {"id":"BR-SEG100-APPJ-CONTEXT-RESTRICTIONS","title":"Entry Mode 10, 82, and terminal capability mode 3 shall be used only in their source-defined card, network, and mPOS contexts.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix J","segment":"111","element":"113","rule":"entry-mode-context-restrictions"},"status":"REVIEW_REQUIRED"}
  ],
