    {"id":"BR-SEG100-APPM-TOTAL-LENGTH","title":"EBT Program Data Element 164 shall begin with a three-digit zero-filled total length matching all following program-data characters.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix M","segment":"103","element":"164","rule":"ebt-program-total-length"},"status":"COVERED"},
    {"id":"BR-SEG100-APPM-TAG-LENGTH","title":"Each EBT Program Data subelement shall contain a valid tag, length, and detail payload whose length matches the declared length.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix M","segment":"103","element":"164","rule":"ebt-program-tag-length-detail"},"status":"COVERED"},
    {"id":"BR-SEG100-APPM-HIP-AMOUNT","title":"HIP purchase/return program data shall use the source-defined account type, amount type, currency, descriptor, and zero-filled amount detail.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix M","segment":"103","element":"164","rule":"hip-purchase-return-amount"},"status":"REVIEW_REQUIRED"},
    {"id":"BR-SEG100-APPM-MULTIPLE-SUBELEMENTS","title":"Element 164 shall support multiple valid program-data subelements with a total length covering all subelements.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix M","segment":"103","element":"164","rule":"multiple-ebt-program-subelements"},"status":"COVERED"}
