  "businessRequirements": [
    {"id":"BR-SEG100-APPQ-COMPOSITION","title":"National POS Condition Code shall contain the source-defined ten-position structure: terminal class, presentation type, security condition, and terminal type.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix Q","segment":"111","element":"113","rule":"pos-condition-code-composition"},"status":"COVERED"},
    {"id":"BR-SEG100-APPQ-TERMINAL","title":"Terminal class and terminal type positions shall use valid Appendix Q values consistent with the physical or digital POS channel.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix Q","segment":"111","element":"113","rule":"pos-condition-terminal-context"},"status":"COVERED"},
    {"id":"BR-SEG100-APPQ-PRESENTATION","title":"Presentation positions shall correctly identify customer/card presence, mail/telephone order, preauthorization, retention capability, and re-presentment state.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix Q","segment":"111","element":"113","rule":"pos-condition-presentation"},"status":"COVERED"},
    {"id":"BR-SEG100-APPQ-SECURITY","title":"Security Condition position shall use valid values for no concern, suspected fraud, verified identification, or electronic commerce digital signature.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix Q","segment":"111","element":"113","rule":"pos-condition-security"},"status":"COVERED"},
    {"id":"BR-SEG100-APPQ-FLOW-CONSISTENCY","title":"POS Condition Code shall be consistent with Segment 100 Prompt Code, entry mode, transaction lifecycle, and eWIC/channel context.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix Q","segment":"111","element":"78,113","rule":"pos-condition-flow-consistency"},"status":"PARTIALLY_COVERED"},
    {"id":"BR-SEG100-APPQ-REQUIREDNESS","title":"National POS Condition Code shall be present for all EMV, internet-based, and Credential on File transactions; it is optional for all other transactions.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix I-19","segment":"111","element":"113","rule":"pos-condition-requiredness"},"status":"COVERED"},
    {"id":"BR-SEG100-APPQ-VISA-CAVV","title":"For Visa transactions, Visa CAVV Data shall be sent when Terminal Type values '25' or '26' are used.","sourceAnchor":{"specification":"ATL105","version":"2026-3","section":"Appendix I-19","segment":"111","element":"113","rule":"pos-condition-visa-cavv-trigger"},"status":"COVERED"}
  ],
  "positionModel": {
    "positions": "1-3 terminal class; 4-7 presentation type; 8 security condition; 9-10 terminal type",
    "reservedRangeFields": ["terminalClass(1-3)","presentationType(4-7)","securityCondition(8)"],
    "flatAssignedListFields": ["terminalType(9-10)"],
    "note": "Terminal Class, Presentation Type, and Security Condition positions each distinguish assigned / reserved-for-national-use / reserved-for-private-use digits per the source text; Terminal Type is a flat list of 21 assigned two-digit codes with no reserved-range language, so any other two-digit value is treated as not valid rather than reserved."
  },
  "terminalTypeCatalog": ["00","01","02","03","04","05","06","07","08","09","10","11","19","20","21","24","25","26","27","28","29"],
