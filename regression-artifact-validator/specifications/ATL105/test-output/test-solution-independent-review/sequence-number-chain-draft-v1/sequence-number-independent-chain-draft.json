      "sourcePage": 402,
      "startLine": 21470,
      "quote": "In the case of a preauthorized transaction, the Sequence Number in the Purchase/Capture is the same Sequence Number as in the transaction’s Authorization Only request.",
      "interpretationStatus": "SOURCE_QUOTE_VERIFIED_INTERPRETATION_REVIEW_REQUIRED"
