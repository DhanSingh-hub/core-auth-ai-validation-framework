      "evidenceId": "ATL105-2026-3-SEC2-3-1-TOR-SEQUENCE",
      "sourcePath": "specifications/ATL105/docs/specs/extracted_text.txt",
      "sourcePage": "2.3.1",
      "startLine": 2009,
      "quote": "The Sequence Number, Account Number, and dollar amount—assigned by the customer’s host/controller/POS system—are the elements used to match a request with its respective response. The Sequence Number of a TOR must be the same as the Sequence Number of the financial transaction being reversed. Each time any financial transaction request is forwarded to BUYPASS, the financial transaction should be assigned a new Sequence Number by the customer’s host/controller/POS system.",
      "interpretationStatus": "SOURCE_QUOTE_VERIFIED_INTERPRETATION_REVIEW_REQUIRED"
    }
