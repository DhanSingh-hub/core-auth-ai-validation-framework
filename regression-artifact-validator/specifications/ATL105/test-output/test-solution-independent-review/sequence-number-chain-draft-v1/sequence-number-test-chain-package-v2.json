    {"id": "BR-RULE-SEG100-R-019", "title": "Sequence Number is six digits and persists through lifecycle", "status": "DRAFT_REVIEW_REQUIRED", "sourceAnchor": {"specification": "ATL105", "version": "2026-3", "section": "12.1", "segment": "100", "element": "86", "rule": "sequence-number"}},
