    {"id": "ATL105-2026-3-SEG102-TAX-PRODUCT-TOTAL", "sourcePage": 226, "startLine": 11578, "quote": "When tax product codes are included in the segment, the total dollar amount of tax products is also reported in Element No. 99 (Tax Amount) in the Standard Message Data Segment (Data Segment No. 100).", "interpretation": "Tax-coded Segment 102 products total into Segment 100 Element 99 when present."},
    {"id": "ATL105-2026-3-TABLE78-CONTEXT", "sourcePage": 625, "startLine": 32051, "quote": "Tag: 78 – Identifier for this structure.", "interpretation": "The following Product Line Item Group uses outer tag 78 and nested sub-tables."},
    {"id": "ATL105-2026-3-TABLE78-LOCAL-TAX-INDICATOR", "sourcePage": 626, "startLine": 32165, "quote": "Sub Table ID \u201c04\u201d Local Tax Included Indicator", "interpretation": "Table 78 tag 04 indicates whether unit cost includes local tax; valid-value text specifies 1 = True."},
    {"id": "ATL105-2026-3-TABLE78-LOCAL-TAX-AMOUNT", "sourcePage": 626, "startLine": 32199, "quote": "n12 Contains the amount of local tax when tag 04 contains a value of 1 (True). Two decimal places are implied.", "interpretation": "Table 78 tag 05 local tax amount is 12 digits, conditional on tag 04 = 1, with two implied decimals."},
    {"id": "ATL105-2026-3-TABLE78-OTHER-TAX-INDICATOR", "sourcePage": 627, "startLine": 32227, "quote": "Sub Table ID \u201c10\u201d Other Tax Included Indicator", "interpretation": "Table 78 tag 10 indicates whether unit cost includes national tax; valid-value text specifies 1 = True."},
    {"id": "ATL105-2026-3-TABLE78-OTHER-TAX-AMOUNT", "sourcePage": 627, "startLine": 32262, "quote": "n12 Contains the amount of other tax when tag 10 contains a value of 1 (True). Two decimal places are implied.", "interpretation": "Table 78 tag 11 other tax amount is 12 digits, conditional on tag 10 = 1, with two implied decimals."},
    {"id": "ATL105-2026-3-TABLE79-CONTEXT", "sourcePage": 628, "startLine": 32321, "quote": "Table ID N3 Fixed Value:079", "interpretation": "The Visa Commercial Card Data structure is table 079."},
    {"id": "ATL105-2026-3-TABLE79-LOCAL-TAX-INDICATOR", "sourcePage": 628, "startLine": 32329, "quote": "Sub Table ID \u201c01\u201d Local Tax Included Indicator", "interpretation": "Table 079 tag 01 indicates whether unit cost includes local tax; valid-value text specifies 1 = True."},
    {"id": "ATL105-2026-3-TABLE79-LOCAL-TAX-AMOUNT", "sourcePage": 628, "startLine": 32363, "quote": "n12 Contains the amount of local tax when tag 01 contains a value of 1 (True). Two decimal places are implied.", "interpretation": "Table 079 tag 02 local tax amount is 12 digits, conditional on tag 01 = 1, with two implied decimals."},
    {"id": "ATL105-2026-3-TABLE79-OTHER-TAX-INDICATOR", "sourcePage": 629, "startLine": 32391, "quote": "Sub Table ID \u201c07\u201d Other Tax Included Indicator", "interpretation": "Table 079 tag 07 indicates whether unit cost includes national tax; valid-value text specifies 1 = True."},
    {"id": "ATL105-2026-3-TABLE79-OTHER-TAX-AMOUNT", "sourcePage": 629, "startLine": 32426, "quote": "n12 Contains the amount of other tax when tag 07 contains a value of 1 (True). Two decimal places are implied.", "interpretation": "Table 079 tag 08 other tax amount is 12 digits, conditional on tag 07 = 1, with two implied decimals."},
