  "businessRequirements": [
    {
      "id": "SAMPLE-BR-SEQ",
      "statement": "For the scoped financial request, Sequence Number (Element 86) must be exactly six ASCII digits with value 000001 through 999999. This does not establish Mastercard eligibility, cross-transaction uniqueness or lifecycle continuity.",
      "claim": {
        "subject": "Segment100.Element86",
        "operator": "asciiDigitsRange",
        "width": 6,
        "minimum": 1,
        "maximum": 999999,
        "modality": "must",
        "conditions": {
          "messageFamily": "STANDARD_FINANCIAL_REQUEST"
        },
        "exceptions": [
          "CAPK_FILE_LOAD_PROFILE_OUT_OF_SCOPE"
        ]
      },
      "businessContext": {
        "platform": "BUYPASS",
        "specification": "ATL105",
        "version": "2026-3",
        "cardProgram": "CREDIT",
        "commercialUsage": "UNRESOLVED",
        "groupId": "MASTERCARD",
        "network": "MASTERCARD",
        "genericCategory": null,
        "processingProfile": "CREDIT",
        "transactionCategory": "SALE",
        "transactionCodes": [
          "0"
        ],
        "candidateCardCodes": [
          "020"
        ],
        "messageFamily": "STANDARD_FINANCIAL_REQUEST",
        "flowId": "SINGLE_STEP_PURCHASE",
        "lifecycleRole": "ORIGINAL",
        "cardPresence": "PRESENT",
        "entryMode": "CONTACT_CHIP",
        "channel": "POS",
        "eligibility": "REVIEW_REQUIRED",
        "mappingBasis": "CONDITIONAL_REVIEW_SELECTION_NOT_APPROVED_COMPATIBILITY"
      },
      "sourceAnchors": [
        {
          "specification": "ATL105",
          "version": "2026-3",
          "section": "13.2",
          "segment": "100",
          "element": "86",
          "rule": "financial-sequence-six-digits-range"
        }
      ],
      "status": "DRAFT_REVIEW_REQUIRED"
    }
  ],
