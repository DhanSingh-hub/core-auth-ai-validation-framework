{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-auth.local/contracts/canonical-anchor.schema.json",
  "title": "Canonical Source Anchor",
  "type": "object",
  "additionalProperties": false,
  "required": ["specification", "version", "segment", "rule"],
  "properties": {
    "specification": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "section": {"type": "string"},
    "segment": {"type": "string", "minLength": 1},
    "element": {"type": "string"},
    "rule": {"type": "string", "minLength": 1},
    "variant": {"type": "string"},
    "canonicalRuleId": {"type": "string", "minLength": 1}
  }
}
