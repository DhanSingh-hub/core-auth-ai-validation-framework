      "BR": "^BR-AI-[A-Z0-9]+-[0-9]+$",
      "TS": "^TS-AI-[A-Z0-9]+-[0-9]+$",
      "TC": "^TC-AI-[A-Z0-9]+-[0-9]+$",
      "TD": "^TD-AI-[A-Z0-9]+-[0-9]+$"
    },
    "TEST_SOLUTION": {
      "BR": "^BR-TEST-[A-Z0-9]+-[0-9]+$",
      "TS": "^TS-TEST-[A-Z0-9]+-[0-9]+$",
      "TC": "^TC-TEST-[A-Z0-9]+-[0-9]+$",
      "TD": "^TD-TEST-[A-Z0-9]+-[0-9]+$"
    }
  },
  "matchStatuses": ["CONFIRMED", "REVIEW_REQUIRED", "MISSING"],
  "matchMethods": ["CANONICAL_ANCHOR", "SEMANTIC_ALIAS", "SME_DECISION"],
